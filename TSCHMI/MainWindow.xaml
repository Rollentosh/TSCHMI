<Window x:Class="TSCHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TSCHMI"
        mc:Ignorable="d"
        Title="Визуализация хеш-таблицы: метод цепочек хеша является односвязный список"
        Height="600" 
        Width="800"
        MinWidth="600"
        MinHeight="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Save"/>
                <MenuItem Header="Load"/>
            </MenuItem>
        </Menu>
        <Grid Name="MainRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" MinWidth="150" MaxWidth="200"/>
            </Grid.ColumnDefinitions>

            <Canvas Name="Canvas" Grid.Column="0"/>

            <Grid Name="Tools" Grid.Column="1" Background="WhiteSmoke">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel Name="Settings" Grid.Row="0">
                    <Label Content="Название"/>
                    <TextBox Margin="5"/>
                    <Label Content="Описание"/>
                    <TextBox Margin="5" MinHeight="40"/>
                    <Label Content="Размер таблицы"/>
                    <Slider Margin="5"/>
                    <RadioButton Content="string" Margin="5"/>
                    <RadioButton Content="int" Margin="5"/>
                    <Button Content="Добавить хэш-таблицу" Margin="5"/>
                    <ListBox Margin="5" MinHeight="40"/>
                    <Button Content="Удалить хэш-таблицу" Margin="5"/>

                </StackPanel>

                <StackPanel Name="Actions" Grid.Row="1">
                    <TextBox Margin="5" MinHeight="40"/>
                    <Button Content="Добавить элемент" Margin="5, 2, 5, 2"/>
                    <Button Content="Удалить элемент" Margin="5, 2, 5, 2"/>
                    <Button Content="Найти элемент" Margin="5, 2, 5, 2"/>
                </StackPanel>

                <DockPanel Name="VisualisationSteps" Grid.Row="2" LastChildFill="False">
                    <Button Content="Шаг вперед" DockPanel.Dock="Bottom" Margin="5, 2, 5, 2"/>
                    <Button Content="Шаг назад" DockPanel.Dock="Bottom" Margin="5, 2, 5, 2"/>
                </DockPanel>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
