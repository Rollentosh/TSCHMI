<Window x:Class="TSCHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TSCHMI"
        mc:Ignorable="d"
        Title="Визуализация хеш-таблицы: метод цепочек хеша является односвязный список"
        Height="600" 
        Width="800"
        MinWidth="600"
        MinHeight="600">
    <Grid Name="MainRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" MinWidth="150" MaxWidth="200"/>
        </Grid.ColumnDefinitions>

        <Canvas Name="Canvas" Grid.Column="0"/>

        <Grid Name="Tools" Grid.Column="1" Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Name="Settings" Grid.Row="0">
                <Label Content="Название"/>
                <TextBox Margin="5,5,5,5"/>
                <Label Content="Описание"/>
                <TextBox Margin="5,5,5,5" MinHeight="40"/>
                <Label Content="Размер таблицы"/>
                <Slider Margin="5,5,5,5"/>
                <RadioButton Content="string" Margin="5,5,5,5"/>
                <RadioButton Content="int" Margin="5,5,5,5"/>
                <Button Content="Добавить хэш-таблицу" Margin="5, 5, 5, 5"/>
                <ListBox Margin="5,5,5,5" MinHeight="40"/>
                <Button Content="Удалить хэш-таблицу" Margin="5, 5, 5, 5"/>

            </StackPanel>

            <StackPanel Name="Actions" Grid.Row="1">
                <TextBox Margin="5,5,5,5" MinHeight="40"/>
                <Button Content="Добавить элемент" Margin="5, 2, 5, 2"/>
                <Button Content="Удалить элемент" Margin="5, 2, 5, 2"/>
                <Button Content="Найти элемент" Margin="5, 2, 5, 2"/>
            </StackPanel>

            <StackPanel Name="VisualisationSteps" Grid.Row="2">
                <Button Content="Шаг вперед" Margin="5, 5, 5, 5"/>
                <Button Content="Шаг назад" Margin="5, 5, 5, 5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
